# Telegram bot token, from @BotFather.
TELEGRAM_BOT_TOKEN=

# Only this Telegram user id may talk to the bot. Send /start to get yours.
TELEGRAM_OWNER_ID=

# Groq, for transcription. Free tier is enough: https://console.groq.com
GROQ_API_KEY=

# Gemini, for the judgement pass.
GEMINI_API_KEY=

# Apify, to resolve a Reel URL into its video URL and metadata.
APIFY_TOKEN=

# Your brand account, to detect Reels you already commented on.
BRAND_INSTAGRAM_HANDLE=

# Set on the host instead of context/brand.md (see context/README.md).
BRAND_CONTEXT=

# Path to a mounted volume when hosted, e.g. /data.
DATA_DIR=
